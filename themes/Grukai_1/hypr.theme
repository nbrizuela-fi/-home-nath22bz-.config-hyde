$HOME/.config/hypr/themes/theme.conf|> $HOME/.config/hypr/themes/colors.conf
#  // P̳r̳a̳s̳a̳n̳t̳h̳ R̳a̳n̳g̳a̳n̳

$GTK_THEME=Grukai
$ICON_THEME=buuf-icons-for-plasma
$COLOR_SCHEME=prefer-dark
$CURSOR_THEME=Simp1e
$CURSOR_SIZE=18
$FONT = Inter

# Paleta Athanor
$bg        = rgba(131311ff)   # dcol_pry1
$bg_alt    = rgba(362920ff)   # dcol_pry2
$brown     = rgba(5E4533ff)   # dcol_pry3
$accent    = rgba(8F8F57ff)   # dcol_1xa4
$accent_hi = rgba(C2C27Aff)   # dcol_1xa6

general {
    gaps_in = 0
    gaps_out = 0
    border_size = 1
    col.active_border = $accent
    col.inactive_border = $bg_alt
    layout = dwindle
    resize_on_border = true
}

group {
    col.border_active = $accent_hi
    col.border_inactive = $bg_alt
    col.border_locked_active = $brown
    col.border_locked_inactive = $bg_alt
}

decoration {
    rounding = 0

    active_opacity = 1
    inactive_opacity = 1
    dim_inactive = false

    blur {
        enabled = true
    }

    shadow {
        enabled = false
    }
}

animations {
    enabled = false
}
